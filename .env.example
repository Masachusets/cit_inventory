# Конфигурация через переменные окружения
# Скопируйте этот файл в .env и настройте под свои нужды

# Server
SERVER_PORT=8080
SERVER_HOST=localhost
SERVER_READ_TIMEOUT=10s
SERVER_WRITE_TIMEOUT=10s
SERVER_IDLE_TIMEOUT=60s
SERVER_SHUTDOWN_TIMEOUT=30s

# Database
# Можно задать полный DSN:
# DATABASE_URL=postgres://user:password@localhost:5432/inventory?sslmode=disable

# Или задать компоненты отдельно:
DB_HOST=localhost
DB_PORT=5432
DB_NAME=inventory
DB_USER=admin
DB_PASSWORD=admin
DB_SSLMODE=disable

# Database connection pool
DATABASE_MAX_CONNECTIONS=25
DATABASE_MIN_CONNECTIONS=5
DATABASE_TIMEOUT=30s
DATABASE_MAX_CONN_LIFETIME=1h
DATABASE_MAX_CONN_IDLE_TIME=30m
DATABASE_RUN_MIGRATIONS=true

# Application
APP_ENVIRONMENT=development
APP_DEBUG=false
APP_LOG_LEVEL=info
APP_LOG_FORMAT=terminal

# Security
# Список через запятую
# SECURITY_TRUSTED_PROXIES=127.0.0.1,10.0.0.0/8
SECURITY_ENABLE_CORS=false
# SECURITY_ALLOWED_ORIGINS=http://localhost:3000,https://example.com
